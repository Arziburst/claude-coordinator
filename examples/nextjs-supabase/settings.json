{
  "_comment": "Example only (non-normative). CANDIDATE deny rules the coordinator offers in the init quiz for a Next.js + Supabase + Vercel project. They are not imposed: the coordinator exists to automate, and some of these actions may be exactly what the project needs (e.g. adding an admin to a single free database so the client can test a task). The owner keeps what fits; the kept rules go into the worker safety settings (settings.example.json). MCP tool names depend on the server's name in your setup — list the connector's tools at init and adapt.",
  "candidate_deny": {
    "production database via CLI": [
      "Bash(supabase db push*)", "Bash(supabase db reset --linked*)", "Bash(supabase link*)",
      "Bash(supabase migration repair*)", "Bash(npx supabase* db *)", "Bash(pnpm supabase* db *)",
      "Bash(yarn supabase* db *)", "Bash(psql *)"
    ],
    "production database via MCP": [
      "mcp__supabase__apply_migration", "mcp__supabase__execute_sql", "mcp__supabase__merge_branch",
      "mcp__supabase__reset_branch", "mcp__supabase__delete_branch", "mcp__supabase__pause_project",
      "mcp__supabase__restore_project"
    ],
    "edge functions and secrets": [
      "Bash(supabase functions deploy*)", "Bash(supabase secrets set*)",
      "mcp__supabase__deploy_edge_function", "mcp__supabase__create_edge_function_secret"
    ],
    "production deploys": [
      "Bash(vercel --prod*)", "Bash(vercel deploy --prod*)", "Bash(vercel deploy --target production*)",
      "Bash(npx vercel* --prod*)", "Bash(vercel promote*)", "Bash(vercel rollback*)",
      "Bash(vercel alias set*)", "Bash(vercel env *)"
    ],
    "code host settings and workflows": [
      "Bash(gh workflow run*)", "Bash(gh secret set*)", "Bash(gh variable set*)", "Bash(gh release*)",
      "Bash(gh api *)", "mcp__github__merge_pull_request"
    ]
  }
