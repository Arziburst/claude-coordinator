{
  "hooks": {
    "SessionStart": [ { "hooks": [ { "type": "command", "command": "bash '/My Core/scripts/hooks/safety-guard.sh' --self-test" } ] } ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/My Core/scripts/hooks/safety-guard.sh'",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
