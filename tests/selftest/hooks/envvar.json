{
  "hooks": {
    "SessionStart": [ { "hooks": [ { "type": "command", "command": "bash /core/scripts/hooks/safety-guard.sh --self-test" } ] } ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$env:CLAUDE_PROJECT_DIR/core/scripts/hooks/safety-guard.ps1\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
